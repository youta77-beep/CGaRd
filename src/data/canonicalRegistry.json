{
  "meta": {
    "database": "ClaimGuard Canonical Registry v1",
    "rule_for_agent": "This JSON is the single source of truth. Render cards ONLY from these records. Any field without a populated provenance_id renders as 'Not on file'. banned_status enum: [BANNED, RESTRICTED, PERMITTED, PERMITTED_WITH_CRITERIA, UNKNOWN]. Evidence counts are computed from substantiation rows, never stored.",
    "issues_solved_structurally": {
      "1_provenance": "T11_provenance FK on every value row",
      "2_template_failure": "No template data exists; null lookup = Not on file",
      "3_status_single_source": "T4_regulatory_status.banned_status only; T9_status_history logs changes",
      "4_substantiation_visibility": "Counts = query over T5 rows joined to T6 evidence_table"
    }
  },
  "tables": {
    "README_schema": [
      {
        "section": "CANONICAL_DB",
        "content": "ClaimGuard registry v1 - single source of truth. The app renders ONLY from these tables."
      },
      {
        "section": "KEYS",
        "content": "product_id -> claims.claim_id -> formula_actives / regulatory_status / substantiation / enforcement / history (1:N). Every renderable value carries provenance_id FK."
      },
      {
        "section": "ISSUE 1 ENFORCED BY",
        "content": "provenance table + FK. Empty provenance_id = render 'Not on file' (see claims c_ker_001, c_tbs_001)."
      },
      {
        "section": "ISSUE 2 ENFORCED BY",
        "content": "No template defaults exist: all values live here. Null lookup = 'Not on file'."
      },
      {
        "section": "ISSUE 3 ENFORCED BY",
        "content": "regulatory_status.banned_status is the ONLY status field; enum [BANNED,RESTRICTED,PERMITTED,PERMITTED_WITH_CRITERIA,UNKNOWN]. status_history logs every change."
      },
      {
        "section": "ISSUE 4 ENFORCED BY",
        "content": "Evidence count = query over substantiation rows (computed_status = ESTABLISHED / count of implicated actives). Counts are never stored. evidence_entry_id FK -> evidence_table."
      },
      {
        "section": "HONESTY RULE",
        "content": "Rows with empty provenance_id or UNKNOWN status are scaffold, not data. Filter status column equivalents before analysis."
      }
    ],
